# Server
PORT=3001
HOST=0.0.0.0

# Supabase (obligatorio en producción; omitir para modo mock local)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MiniMax (Fase 1+) — https://platform.minimax.io/user-center/basic-information
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2

# Make.com — webhook entrante (mismo valor en el escenario HTTP y backend/.env)
MAKE_WEBHOOK_SECRET=your-make-webhook-secret

# Make.com REST API (Fase 2) — crear escenarios desde scripts
# Token: https://us2.make.com/profile (pestaña API) — scopes:
#   scenarios:read scenarios:write hooks:read hooks:write teams:read connections:read
MAKE_API_TOKEN=
MAKE_API_ZONE=us2
MAKE_TEAM_ID=

# HITL — token para panel de revisión humana (usado en x-hitl-token header)
HITL_TOKEN=
