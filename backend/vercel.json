{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/", "destination": "/api/health", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    }
  }
}
