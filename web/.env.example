# Copiar a .env.local para desarrollo
# Local (debe coincidir con el puerto donde corre la API; si Next ocupara 3001, usa otro puerto para el backend y ponlo aquí)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Producción (Vercel → Environment Variables del proyecto web)
# NEXT_PUBLIC_API_URL=https://tu-api.example.com

# Opcional: coincide con MAKE_WEBHOOK_SECRET del backend si pruebas ingestión desde el playground web.
# Evita publicar el valor en sitios abiertos.
# NEXT_PUBLIC_MAKE_WEBHOOK_SECRET=

# HITL token — debe coincidir con HITL_TOKEN en backend/.env
NEXT_PUBLIC_HITL_TOKEN=